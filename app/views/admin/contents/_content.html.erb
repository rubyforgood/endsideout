<%# locals: (content:, content_iteration:) %>
<% contentable = content.contentable %>
<tr>
  <% case contentable %>
  <% when Link %>
    <td><%= link_to "#{contentable.title} ↗", safe_external_url(contentable.url), target: "_blank", rel: "noopener noreferrer", class: "link inline-flex items-center gap-1" %></td>
    <td><%= contentable.link_type.humanize %></td>
  <% when Game %>
    <td><%= contentable.title %></td>
    <td>Game</td>
  <% end %>
  <td>
    <div class="flex gap-2">
      <%= render "admin/shared/move_buttons", url: admin_content_position_path(content), title: contentable.title,
            first: content_iteration.first?, last: content_iteration.last? %>
      <%= link_to "Edit", edit_polymorphic_path([:admin, contentable]), class: "btn btn-xs btn-primary" %>
      <%= button_to "Remove", admin_content_path(content), method: :delete,
            data: { "turbo-confirm": "Remove this item from the module?" },
            class: "btn btn-xs btn-error" %>
    </div>
  </td>
</tr>
