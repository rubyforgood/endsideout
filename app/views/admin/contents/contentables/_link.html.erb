<% link = content.contentable %>
<tr>
  <td><%= link_to "#{link.title} ↗", safe_external_url(link.url), target: "_blank", rel: "noopener noreferrer", class: "link inline-flex items-center gap-1" %></td>
  <td><%= link.link_type.humanize %></td>
  <td>
    <div class="flex gap-2">
      <%= render "admin/shared/move_buttons", url: admin_content_position_path(content), title: link.title, first: first, last: last %>
      <%= link_to "Edit", edit_admin_link_path(link), class: "btn btn-xs btn-primary" %>
      <%= button_to "Delete", admin_content_path(content), method: :delete,
            data: { "turbo-confirm": "Delete this link?" },
            class: "btn btn-xs btn-error" %>
    </div>
  </td>
</tr>
