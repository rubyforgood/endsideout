<%= button_to "↑", admin_content_position_path(content), method: :patch, params: { direction: "up" },
      disabled: first, class: "btn btn-xs", aria: { label: "Move #{title} up" } %>
<%= button_to "↓", admin_content_position_path(content), method: :patch, params: { direction: "down" },
      disabled: last, class: "btn btn-xs", aria: { label: "Move #{title} down" } %>
