<% content_for :title, "Content Modules" %>

<p style="color: green"><%= notice %></p>
<p style="color: red"><%= alert %></p>

<header class="flex justify-between items-center mb-4">
  <h1 class="text-2xl">Content Modules</h1>
  <%= link_to "New module", new_admin_content_module_path, class: "btn btn-primary" %>
</header>

<div role="tablist" class="tabs tabs-border mb-6">
  <% @programs.each do |program| # herb:debug disable %>
    <%= link_to admin_content_modules_path(program_id: program.id),
          role: "tab",
          aria: { selected: program == @active_program },
          class: "tab #{"tab-active" if program == @active_program}" do %>
      <%= program.name %>
    <% end %>
  <% end %>
</div>

<% ContentModule.levels.each_key do |level| %>
  <% modules = @modules_by_level[level] || [] %>
  <section class="mb-8">
    <h2 class="text-lg font-semibold mb-2"><%= level.humanize %></h2>
    <% if modules.any? %>
      <div class="overflow-x-auto rounded-box border border-base-content/5 bg-base-100">
        <table class="table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Contents</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <%= render partial: "admin/content_modules/content_module", collection: modules %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-sm opacity-60">No modules for this level yet.</p>
    <% end %>
  </section>
<% end %>
