<%# locals: (content_module:, content_module_iteration:) %>
<%= tag.tr id: dom_id(content_module) do %>
  <td><%= content_module.name %></td>
  <td><%= content_module.contents.size %></td>
  <td>
    <div class="flex gap-2">
      <%= render "admin/shared/move_buttons", url: admin_content_module_position_path(content_module), name: content_module.name,
            is_first: content_module_iteration.first?, is_last: content_module_iteration.last? %>
      <%= link_to "Edit", edit_admin_content_module_path(content_module), class: "btn btn-sm btn-primary" %>
      <%= button_to "Delete", admin_content_module_path(content_module), method: :delete,
            data: { "turbo-confirm": "Delete this module?" },
            class: "btn btn-sm btn-error" %>
    </div>
  </td>
<% end %>
