<% content_for :title, "Edit Module" %>

<nav class="breadcrumbs text-sm">
  <ul>
    <li><%= link_to "Content Modules", admin_content_modules_path %></li>
    <li>Edit Module</li>
  </ul>
</nav>
<p style="color: green"><%= notice %></p>
<p style="color: red"><%= alert %></p>
<section class="py-10 flex justify-center">
  <div class="flex flex-col gap-6 w-full max-w-lg">
    <div class="card card-border bg-base-100 shadow-md">
      <div class="card-body">
        <h1 class="card-title">Edit Module</h1>
        <%= render "form", content_module: @content_module %>
      </div>
    </div>

    <div class="card card-border bg-base-100 shadow-md">
      <div class="card-body">
        <div class="flex justify-between items-center mb-2 gap-2 flex-wrap">
          <h2 class="card-title text-lg">Contents</h2>
          <div class="flex items-center gap-2">
            <% if @available_games.any? %>
              <%= form_with url: admin_content_module_contents_path(@content_module), scope: :content, class: "flex gap-2" do |form| %>
                <%= form.select :contentable_id, options_from_collection_for_select(@available_games, :id, :title),
                      {}, class: "select select-sm", aria: { label: "Game" } %>
                <%= form.submit "Add game", class: "btn btn-sm btn-primary" %>
              <% end %>
            <% end %>
            <%= link_to "Add link", new_admin_content_module_link_path(@content_module), class: "btn btn-sm btn-primary" %>
          </div>
        </div>
        <% if @contents.any? %>
          <table class="table">
            <thead>
              <tr>
                <th>Title</th>
                <th>Type</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <%= render partial: "admin/contents/content", collection: @contents %>
            </tbody>
          </table>
        <% else %>
          <p class="text-sm opacity-60">No contents yet.</p>
        <% end %>
      </div>
    </div>
  </div>
</section>
