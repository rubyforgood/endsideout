<% content_for :title, "Games" %>

<p style="color: green"><%= notice %></p>
<p style="color: red"><%= alert %></p>

<header class="flex justify-between items-center mb-4">
  <h1 class="text-2xl">Games</h1>
  <%= link_to "New game", new_admin_game_path, class: "btn btn-primary" %>
</header>

<% if @games.any? %>
  <div class="overflow-x-auto rounded-box border border-base-content/5 bg-base-100">
    <table class="table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Slug</th>
          <th>Modules</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @games.each do |game| %>
          <tr>
            <td><%= link_to game.title, [:admin, game], class: "link" %></td>
            <td><%= game.slug %></td>
            <td><%= game.content_modules.size %></td>
            <td>
              <div class="flex gap-2">
                <%= link_to "Edit", edit_admin_game_path(game), class: "btn btn-sm btn-primary" %>
                <%= button_to "Delete", [:admin, game], method: :delete,
                      data: { "turbo-confirm": delete_game_confirmation(game) },
                      class: "btn btn-sm btn-error" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-sm opacity-60">No games yet.</p>
<% end %>
