<% content_for :title, @game.title %>

<p style="color: green"><%= notice %></p>
<p style="color: red"><%= alert %></p>

<nav class="breadcrumbs text-sm">
  <ul>
    <li><%= link_to "Games", admin_games_path %></li>
    <li><%= @game.title %></li>
  </ul>
</nav>

<header class="flex items-center justify-between mb-4">
  <h1 class="text-2xl"><%= @game.title %></h1>
  <div class="flex gap-2">
    <%= link_to "Edit this game", edit_admin_game_path(@game), class: "btn btn-primary" %>
    <%= button_to "Delete this game", [:admin, @game], method: :delete,
          data: { "turbo-confirm": delete_game_confirmation(@game) },
          class: "btn btn-error" %>
  </div>
</header>

<dl class="mb-8 space-y-4">
  <div>
    <dt class="font-semibold">Slug</dt>
    <dd><%= @game.slug %></dd>
  </div>
  <div>
    <dt class="font-semibold">Description</dt>
    <dd><%= @game.description.presence || "No description." %></dd>
  </div>
</dl>

<section>
  <h2 class="text-lg font-semibold mb-2">Modules</h2>
  <% if @content_modules.any? %>
    <ul class="list-disc pl-6">
      <% @content_modules.each do |content_module| %>
        <li><%= link_to content_module.name, edit_admin_content_module_path(content_module), class: "link" %></li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-sm opacity-60">Not in any module yet.</p>
  <% end %>
</section>
