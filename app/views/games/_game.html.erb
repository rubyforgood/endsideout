<div id="<%= dom_id game %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Title:</strong>
    <%= game.title %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Slug:</strong>
    <%= game.slug %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Content module:</strong>
    <%= game.content_module_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Description:</strong>
    <%= game.description %>
  </div>
</div>
