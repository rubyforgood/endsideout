<% content_for :title, "New student" %>

<nav class="breadcrumbs text-sm">
  <ul>
    <li><%= link_to "All Schools", schools_path %></li>
    <li><%= link_to @student.school.name, school_path(@student.school, tab: "students") %></li>
    <li>New Student</li>
  </ul>
</nav>
<section class="py-10 flex items-center justify-center">
  <div class="card card-border bg-base-100 shadow-md w-96">
    <div class="card-body">
      <h1 class="card-title">New Student</h1>
      <%= render "form", student: @student, url: school_students_path(@school), classrooms: @school.classrooms %>
    </div>
  </div>
</section>
