<div id="<%= dom_id student %>">
  <div>
    <strong>First name:</strong>
    <%= student.first_name %>
  </div>

  <div>
    <strong>Last name:</strong>
    <%= student.last_name %>
  </div>

  <div>
    <strong>Email:</strong>
    <%= student.email %>
  </div>

  <div>
    <strong>Grade level:</strong>
    <%= student.grade_level %>
  </div>

  <div>
    <strong>Gender:</strong>
    <%= student.gender %>
  </div>

</div>
