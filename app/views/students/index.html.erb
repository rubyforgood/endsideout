<%= turbo_frame_tag dom_id(@school, :students) do %>
  <p style="color: green"><%= notice %></p>

  <header class="flex items-center justify-between mb-4">
    <h2 class="text-xl">Students</h2>
    <%= link_to "New student", new_school_student_path(@school), data: { turbo_frame: "_top" }, class: "btn btn-primary" %>
  </header>
  <div class="overflow-x-auto rounded-box border border-base-content/5 bg-base-100">
  <table id="students" class="table">

    <thead>
    <tr>
      <th>First name</th>
      <th>Last name</th>
      <th>Email</th>
      <th>Grade level</th>
      <th>Gender</th>
      <th>Classroom</th>
      <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    <% @students.each do |student| %>
      <tr>
        <td><%= student.first_name %></td>
        <td><%= student.last_name %></td>
        <td><%= student.email %></td>
        <td><%= student.grade_level %></td>
        <td><%= student.gender %></td>
        <td><%= link_to student.classroom.name, edit_classroom_path(student.classroom), data: { turbo_frame: "_top" }, class: "btn btn-link" %></td>
        <td>
          <div class="flex gap-2">
            <%= link_to "Edit", edit_student_path(student), data: { turbo_frame: "_top" }, class: "btn btn-primary" %>
            <%= button_to "Delete", student, method: :delete, data: { turbo_frame: "_top", "turbo-confirm": "Are you sure?" }, class: "btn btn-error" %>
          </div>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
  </div>
<% end %>
