<%= turbo_frame_tag dom_id(@school, :teachers) do %>
  <p style="color: green"><%= notice %></p>

  <header class="flex items-center justify-between mb-4">
    <h2 class="text-xl">Teachers</h2>
    <%= link_to "New teacher", new_school_teacher_path(@school), data: { turbo_frame: "_top" }, class: "btn btn-primary" %>
  </header>

  <div class="overflow-x-auto rounded-box border border-base-content/5 bg-base-100">
    <table class="table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Classrooms</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @teachers.each do |teacher| %>
          <tr>
            <td><%= teacher.name %></td>
            <td><%= teacher.email %></td>
            <td><%= teacher.classrooms.map(&:name).join(", ") %></td>
            <td>
              <div class="flex gap-2">
                <%= link_to "Edit", edit_teacher_path(teacher), data: { turbo_frame: "_top" }, class: "btn btn-primary" %>
                <%= button_to "Delete", teacher_path(teacher), method: :delete, data: { turbo_frame: "_top", turbo_confirm: "Are you sure?" }, class: "btn btn-error" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
