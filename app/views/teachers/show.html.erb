<p style="color: green"><%= notice %></p>

<% content_for :title, @teacher.name %>

<nav class="breadcrumbs text-sm">
  <ul>
    <li><%= link_to "All Schools", schools_path %></li>
    <li><%= link_to @teacher.school.name, school_teachers_path(@teacher.school) %></li>
    <li><%= @teacher.name %></li>
  </ul>
</nav>

<div class="space-y-4">
  <div>
    <h1 class="text-2xl"><%= @teacher.name %></h1>
  </div>

  <div>
    <strong>Email:</strong>
    <%= @teacher.email.presence || "—" %>
  </div>

  <div>
    <strong>Classrooms:</strong>
    <%= @teacher.classrooms.map(&:name).presence&.join(", ") || "None assigned" %>
  </div>

  <div class="flex gap-2">
    <%= link_to "Edit", edit_teacher_path(@teacher), class: "btn btn-primary" %>
    <%= link_to "Back to teachers", school_teachers_path(@teacher.school), class: "btn btn-secondary" %>
  </div>
</div>
